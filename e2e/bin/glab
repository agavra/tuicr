#!/usr/bin/env python3
# Fake `glab`: hands argv to the shared fake-forge entry point (e2e/fakeforge/main.py).
import os
import sys
from pathlib import Path

main = Path(__file__).resolve().parent.parent / "fakeforge" / "main.py"
os.execv(sys.executable, [sys.executable, str(main), "glab", *sys.argv[1:]])
